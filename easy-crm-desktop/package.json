{
  "name": "a11-crm-desktop",
  "version": "1.0.45",
  "description": "A11 CRM Desktop com Bot do WhatsApp",
  "author": "Alessandro Uchoa",
  "repository": {
    "type": "git",
    "url": "https://github.com/alessandroaun/a11-crm-releases.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.a11crm.desktop",
    "productName": "A11 CRM",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "server.js",
      "updater.html",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "A11 CRM",
      "installerIcon": "assets/installicon.ico",
      "uninstallerIcon": "assets/installicon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "electron-serve": "^1.3.0",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^2.2.0",
    "qrcode": "^1.5.3",
    "whatsapp-web.js": "^1.23.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  }
}